+@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap");
+:root {
+  --pink: #ff003b;
+  --gold: #e3a535;
+  --ink: #211b1d;
+  --muted: #6a5c61;
+  --line: #e6dce0;
+  --paper: #faf7f5;
+  font-family: "DM Sans", Arial, sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+  color-scheme: light;
+}
+* { box-sizing: border-box; }
+body { margin: 0; }
+button, input, textarea, select { font: inherit; }
+button { cursor: pointer; }
+button:disabled { opacity: .45; cursor: default; }
+button, input, textarea, select { border-radius: 0; }
+button { min-height: 44px; }
+input, select, textarea { width: 100%; color: var(--ink); background: white; border: 1px solid #bbaaaf; padding: .75rem; }
+input, select { min-height: 46px; }
+textarea { resize: vertical; }
+:focus-visible { outline: 2px solid #aa0028; outline-offset: 3px; }
+label { display: block; font-weight: 600; font-size: .8125rem; margin-block-end: .4rem; }
+.masthead { padding: 1rem max(1rem, calc((100vw - 1320px) / 2)); display: flex; align-items: center; justify-content: space-between; background: white; border-block-end: 1px solid var(--line); gap: 1rem; }
+.masthead img { width: 140px; height: auto; }
+#directionToggle { border: 1px solid var(--line); background: white; padding-inline: .85rem; font-size: .8125rem; }
+.page-wrapper { width: min(100% - 2rem, 1320px); margin-inline: auto; }
+.intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding-block: 2.5rem; }
+.eyebrow { text-transform: uppercase; font-size: .7rem; letter-spacing: .16em; margin-block: 0 .8rem; }
+h1 { font: 500 clamp(2.8rem, 5vw, 5rem)/1 "Playfair Display", Georgia, serif; letter-spacing: -.045em; margin: 0; }
+h1 em { color: #a30031; }
+.intro > p { max-width: 32ch; color: var(--muted); line-height: 1.6; }
+.workspace { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(340px, .8fr); gap: 2rem; align-items: start; }
+.section-heading { display: flex; align-items: center; justify-content: space-between; gap: .6rem; margin-block-end: 1rem; }
+h2 { font-size: 1.125rem; margin: 0; }
+#productCount { color: var(--muted); font-size: .8125rem; }
+.filters { display: grid; grid-template-columns: 1.4fr 1fr; gap: .75rem; }
+#catalogStatus { font-size: .875rem; color: var(--muted); }
+.products-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
+.product-card { border: 1px solid var(--line); background: white; min-width: 0; position: relative; }
+.product-card.selected { border-color: var(--pink); box-shadow: inset 0 0 0 1px var(--pink); }
+.product-choice { display: block; width: 100%; text-align: start; background: transparent; color: var(--ink); padding: 1rem; border: 0; }
+.product-choice:hover { background: #fff9fa; }
+.product-photo { height: 160px; display: grid; place-items: center; margin-block-end: .8rem; background: #faf8f7; }
+.product-photo img { width: 85%; height: 145px; object-fit: contain; mix-blend-mode: multiply; }
+.product-brand { display: block; color: var(--muted); font-size: .75rem; margin-block-end: .35rem; }
+.product-name { display: block; font-size: .9375rem; font-weight: 700; line-height: 1.4; min-height: 2.8em; }
+.selection-state { display: inline-block; font-size: .75rem; margin-block-start: .7rem; padding-block: .25rem; border-block-end: 2px solid var(--gold); }
+.selected .selection-state { border-color: var(--pink); color: #a30031; }
+.product-card details { margin: 0 1rem 1rem; font-size: .8125rem; line-height: 1.5; }
+summary { cursor: pointer; min-height: 44px; padding-block: .7rem; }
+details p { margin: 0; color: var(--muted); }
+.routine-panel { min-width: 0; display: grid; gap: 1rem; }
+.selection, .chatbox { padding: 1.25rem; border: 1px solid var(--line); background: white; }
+.selection { border-block-start: 3px solid var(--gold); }
+#selectionCount { color: var(--muted); font-weight: 400; font-size: .875rem; }
+.text-button { border: 0; background: transparent; padding-inline: .25rem; text-decoration: underline; text-underline-offset: .25em; color: var(--ink); font-size: .75rem; }
+.selected-item { display: flex; justify-content: space-between; align-items: center; gap: .6rem; border-block-end: 1px solid var(--line); padding-block: .65rem; font-size: .8125rem; }
+.selected-item small { display: block; color: var(--muted); margin-block-end: .2rem; }
+.remove-button { background: white; color: #a30031; border: 0; text-decoration: underline; font-size: .75rem; padding: .3rem; }
+.empty { font-size: .875rem; line-height: 1.5; color: var(--muted); }
+#selectedProductsList { max-height: 240px; overflow: auto; margin-block-end: 1rem; }
+.optional { font-weight: 400; color: var(--muted); }
+.primary { display: flex; align-items: center; justify-content: space-between; width: 100%; background: var(--ink); border: 0; border-block-end: 3px solid var(--pink); color: white; padding: .85rem 1rem; font-weight: 700; margin-block-start: .75rem; }
+.primary:hover:enabled { background: #5d0b27; }
+.context-note { color: var(--muted); font-size: .75rem; line-height: 1.5; }
+.chat-window { height: 330px; overflow-y: auto; background: #fcf9f8; padding: .75rem; border: 1px solid var(--line); }
+.msg { width: fit-content; max-width: 95%; padding: .75rem; background: #f6eaee; margin-block-end: .75rem; }
+.msg.user { margin-inline-start: auto; background: var(--ink); color: white; }
+.msg strong { font-size: .7rem; }
+.msg p { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.55; font-size: .875rem; margin: .3rem 0 0; }
+.sources { margin-block-start: .6rem; display: grid; gap: .35rem; }
+.sources a { color: #8e173b; font-size: .75rem; overflow-wrap: anywhere; }
+.chat-form { display: flex; margin-block-start: .75rem; }
+.chat-form input { min-width: 0; flex: 1; }
+.chat-form button { background: var(--ink); color: white; border: 0; padding-inline: .8rem; }
+#chatStatus, #storageStatus { color: #9c002e; font-size: .8125rem; line-height: 1.5; }
+#chatStatus:empty, #storageStatus:empty, .context-note:empty { margin: 0; }
+.fine-print { font-size: .7rem; line-height: 1.5; color: var(--muted); }
+footer { width: min(100% - 2rem, 1320px); border-block-start: 1px solid var(--line); padding-block: 1rem; margin: 2.5rem auto 0; font-size: .75rem; color: var(--muted); }
+.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+[dir="rtl"] .intro, [dir="rtl"] .section-heading { text-align: start; }
+[dir="rtl"] input, [dir="rtl"] textarea { text-align: start; }
+@media (min-width: 1050px) { .products-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+@media (max-width: 850px) {
+  .workspace { grid-template-columns: 1fr; }
+  .intro { align-items: start; padding-block: 1.5rem; }
+  .intro > p { max-width: 24ch; font-size: .875rem; }
+}
+@media (max-width: 480px) {
+  .intro { display: block; }
+  .intro > p { max-width: 34ch; }
+  .filters { grid-template-columns: 1fr; }
+  .product-choice { padding: .65rem; }
+  .product-card details { margin-inline: .65rem; }
+  .product-photo { height: 125px; }
+  .product-photo img { height: 115px; }
+  .selection, .chatbox { padding: 1rem; }
+}
+.msg.ai p a { color: #8e173b; text-decoration: underline; text-underline-offset: .15em; }
+
+.jump-link { color: #8e173b; font-size: .8125rem; text-underline-offset: .2em; padding-block: .6rem; }
